#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:8
msgid "Refresh interval in milliseconds"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:9
msgid ""
"How frequently the network speed is polled from /proc/net/dev. Lower values "
"give more responsive readings but consume more CPU. Recommended range: 1000–"
"3000."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:18
msgid "Display speed in bits per second"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:19
msgid ""
"When true, speeds are shown in Kbps/Mbps (bits). When false, speeds are "
"shown in KB/s/MB/s (bytes). Default is bytes (false)."
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:28
msgid "Show upload speed"
msgstr ""

#: src/schemas/org.gnome.shell.extensions.speed-meter.gschema.xml:29
